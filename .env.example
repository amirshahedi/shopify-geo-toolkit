# Store subdomain, without .myshopify.com — e.g. "anabon-security"
SHOPIFY_STORE=your-store-name

# Admin API access token from an admin-created custom app.
# Settings -> Apps and sales channels -> Develop apps -> Create an app
# Grant it read_products and read_content scopes, install it, copy the token.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
